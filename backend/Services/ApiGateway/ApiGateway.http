@ApiGateway_HostAddress = http://localhost:5080

### Login through the Gateway
POST {{ApiGateway_HostAddress}}/auth/login
Content-Type: application/json

{
  "email": "admin@uta.edu.ec",
  "password": "<contraseña configurada con User Secrets>"
}

### Copy the accessToken from the login response.
@accessToken = replace-with-access-token

### Get the authenticated user through the Gateway
GET {{ApiGateway_HostAddress}}/auth/me
Authorization: Bearer {{accessToken}}
Accept: application/json
